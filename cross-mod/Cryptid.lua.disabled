-- CONSUMABLE
-- PLANET
-- The Complete Fucking Annihilation of Reality
-----------------------------------------------
local function hand_color(hand_key)
	local hand_level = G.GAME.hands[hand_key].level
	return (
		to_big(hand_level) == to_big(1) and G.C.UI.TEXT_DARK
		or G.C.HAND_LEVELS[to_big(math.min(7, hand_level)):to_number()]
	)
end

---@type SMODS.Consumable
local reality = {
	dependencies = {
		items = {
			"set_cry_poker_hand_stuff"
		}
	},
	object_type = "Consumable",

	set = 'Planet',
	key = 'reality',
	loc_vars = function ()
		return {
			vars = {
				localize("ovn_5DDeck"),
				G.GAME.hands["ovn_5DDeck"].level,
				G.GAME.hands["ovn_5DDeck"].l_mult,
				G.GAME.hands["ovn_5DDeck"].l_chips,
				colours = {hand_color("ovn_5DDeck")}
			}
		}
	end,
	config = { hand_type = 'ovn_5DDeck', softlock = true },
	generate_ui = 0,

	atlas = "cryptidplanets",
	pos = { x = 0, y = 0 },

	set_card_type_badge = function(self, card, badges)
		badges[1] = create_badge('WHAT THE FUCK', get_type_colour(self or card.config, card), G.C.WHITE, 1.5)
	end,

	aurinko = true,
}

